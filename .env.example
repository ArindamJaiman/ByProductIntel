# ByProduct Intelligence — environment variables
# Copy to .env.local. With nothing set, the app runs in demo mode.

# Force a mode: "demo" or "supabase". Omit to auto-detect.
# BPI_DATA_MODE=demo

# Demo store location (default .data/demo-store.json)
# BPI_DEMO_STORE_PATH=.data/demo-store.json

# --- Persistent mode (Supabase) ---
# Public values: safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SERVER-SIDE ONLY. Used by `npm run seed:supabase`. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Optional outside services. SERVER-SIDE ONLY. ---
# Put real keys in .env.local (git-ignored) and in your host's environment settings, never in this file.

# Lab report reader (Google Gemini API, https://aistudio.google.com/apikey).
# GEMINI_API_KEY=
# Optional model id, e.g. gemini-flash-latest or gemini-2.5-flash. Defaults to gemini-flash-latest.
# GEMINI_MODEL=

# Backup lab report reader, used when Gemini is unavailable (Mistral AI, https://console.mistral.ai).
# MISTRAL_API_KEY=
# Optional chat model id. Defaults to mistral-small-latest.
# MISTRAL_MODEL=

# Road routes for distances (OpenRouteService, https://account.heigit.org).
# ORS_API_KEY=

# Set to 1 to switch every outside service off without removing the keys.
# BPI_DISABLE_EXTERNAL_SERVICES=1
